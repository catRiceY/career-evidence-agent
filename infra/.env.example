POSTGRES_DB=career_evidence
POSTGRES_USER=career_agent
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=54329

# Keep real values only in infra/.env, which is ignored by Git.
# This template must never contain a real API key.
CAREER_AGENT_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CAREER_AGENT_EMBEDDING_API_KEY=replace-with-an-embedding-api-key
CAREER_AGENT_EMBEDDING_MODEL=qwen3.7-text-embedding
CAREER_AGENT_EMBEDDING_DIMENSIONS=1024

# Optional overrides for answer drafting. In local development, absent values
# reuse the embedding endpoint/key and default to qwen3.6-flash.
CAREER_AGENT_CHAT_BASE_URL=
CAREER_AGENT_CHAT_API_KEY=
CAREER_AGENT_CHAT_MODEL=qwen3.6-flash
CAREER_AGENT_CHAT_MAX_OUTPUT_TOKENS=700

# Private Studio is disabled unless this is set in infra/.env. Use a unique
# random value and never put it in frontend code, a URL, or Git history.
CAREER_AGENT_OWNER_TOKEN=

# Required only for `docker compose --profile automation up -d n8n`.
N8N_ENCRYPTION_KEY=
CAREER_AGENT_PRIVATE_API_URL=http://host.docker.internal:8000

# Optional OpenTelemetry export. Leave blank for local-only operation.
# When all Langfuse fields are set, the API exports OTLP v4 traces to Langfuse.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Or point to a generic OTLP/HTTP traces endpoint instead of Langfuse.
CAREER_AGENT_OTEL_EXPORTER_OTLP_ENDPOINT=
